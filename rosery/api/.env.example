# Server configuration only. No value in this file belongs in the iOS app.
# Load with your process supervisor or export explicitly; the API does not read .env.
ROSERY_ENV=development
ROSERY_ADDR=127.0.0.1:8080
QF_ENV=prelive
QF_CLIENT_ID=
QF_CLIENT_SECRET=
APPLE_APP_ID=6JR3ZGLPD6.mujhtech.rosery
APP_ATTEST_ENVIRONMENT=development
ROSERY_STORE_PATH=data/attest-development.db
ROSERY_MAX_CONCURRENT=64

# Production requires all of these, plus approved QF production credentials:
# ROSERY_ENV=production
# QF_ENV=production
# APP_ATTEST_ENVIRONMENT=production
# ROSERY_STORE_PATH=/var/lib/rosery/attest-production.db
# ROSERY_TRUSTED_PROXIES=127.0.0.1/32,::1/128
# ROSERY_ORIGIN_TOKEN=<generate at least 32 cryptographically random characters>
# A private HTTPS ingress injects this token; never embed it in the app.
